# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Server Port (Default 3000 in AI Studio / Cloud Run)
PORT=3000

# MongoDB Connection String (e.g. mongodb://localhost:27017/homeassist or MongoDB Atlas URL)
# If left empty, HomeAssist will seamlessly run on resilient embedded persistent storage for zero-config demos!
MONGODB_URI="mongodb://localhost:27017/homeassist"

# JWT Secret for signing authentication tokens
JWT_SECRET="homeassist_super_secret_jwt_key_hackathon_2025"

# Client URL (for CORS)
CLIENT_URL="http://localhost:3000"

# Frontend API URL (Optional if serving from same origin)
VITE_API_URL=""

